# Copie para .env (cp .env.example .env) e preencha. NUNCA suba o .env para o GitHub.
DB_NAME=nino
DB_USER=nino_app
DB_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
# 32+ caracteres. Gere com:  openssl rand -base64 48
JWT_KEY=troque-por-um-valor-aleatorio-com-48-ou-mais-caracteres
# Chave de criptografia das emoções (pgcrypto). 32+ caracteres. Se perder, os dados cifrados ficam ilegíveis.
DB_ENC_KEY=troque-por-outro-valor-aleatorio-com-32-ou-mais-caracteres
PASSWORD_MAX_AGE_DAYS=90

# Observabilidade (só necessário para: docker compose --profile obs up -d)
# Chave em: Datadog > Organization Settings > API Keys. NUNCA suba para o GitHub.
DD_API_KEY=cole-a-chave-do-datadog-aqui
DD_SITE=datadoghq.com
